{
  "openapi": "3.0.3",
  "info": {
    "title": "Handy Transcription API",
    "description": "Local speech-to-text API. OpenAI-compatible audio endpoints plus Handy-native optimized routes. Lazy model loading when enabled. Auth via Bearer token (loopback only).",
    "version": "0.9.4"
  },
  "servers": [{ "url": "http://127.0.0.1:17373" }],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "HealthResponse": { "type": "object", "properties": { "status": { "type": "string" }, "port": { "type": "integer" } } },
      "ModelInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "parakeet-tdt-0.6b-v3" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "is_downloaded": { "type": "boolean" },
          "is_downloading": { "type": "boolean" },
          "engine_type": { "type": "string" },
          "supports_streaming": { "type": "boolean" },
          "supports_translation": { "type": "boolean" },
          "supported_languages": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ModelListResponse": {
        "type": "object",
        "properties": {
          "object": { "type": "string", "example": "list" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "object": { "type": "string", "example": "model" },
                "created": { "type": "integer" },
                "owned_by": { "type": "string", "example": "handy" }
              }
            }
          }
        }
      },
      "ModelStatus": {
        "type": "object",
        "properties": {
          "is_loaded": { "type": "boolean" },
          "current_model": { "type": "string", "nullable": true },
          "loaded_models": { "type": "array", "items": { "type": "string" } },
          "is_loading": { "type": "boolean" }
        }
      },
      "LoadRequest": { "type": "object", "properties": { "model": { "type": "string" }, "device_index": { "type": "integer", "nullable": true } }, "required": ["model"] },
      "UnloadRequest": { "type": "object", "properties": { "model": { "type": "string" } } },
      "TranscribeResponse": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "model": { "type": "string" },
          "language": { "type": "string", "nullable": true },
          "duration_ms": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": { "get": { "summary": "Health check", "security": [], "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } } } } },
    "/api/models": { "get": { "summary": "List models (Handy-native)", "responses": { "200": { "description": "models", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ModelInfo" } } } } } } },
    "/v1/models": { "get": { "summary": "List models (OpenAI-compatible)", "responses": { "200": { "description": "models", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelListResponse" } } } } } } },
    "/api/model/status": { "get": { "summary": "Loaded model status", "responses": { "200": { "description": "status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelStatus" } } } } } } },
    "/api/model/load": { "post": { "summary": "Load a model", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoadRequest" } } } }, "responses": { "200": { "description": "loaded" }, "403": { "description": "policy forbids" }, "503": { "description": "OS speech unavailable" } } } },
    "/api/model/unload": { "post": { "summary": "Unload model(s)", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnloadRequest" } } } }, "responses": { "200": { "description": "unloaded" } } } },
    "/api/transcribe": {
      "post": {
        "summary": "Transcribe audio (Handy-optimized)",
        "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" }, "model": { "type": "string" }, "language": { "type": "string" }, "translate": { "type": "boolean" }, "prompt": { "type": "string" }, "response_format": { "type": "string", "enum": ["json", "text"] } }, "required": ["file"] } } } },
        "responses": { "200": { "description": "transcription", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TranscribeResponse" } }, "text/plain": { "schema": { "type": "string" } } } } }
      }
    },
    "/v1/audio/transcriptions": {
      "post": {
        "summary": "Transcribe audio (OpenAI-compatible)",
        "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" }, "model": { "type": "string" }, "language": { "type": "string" }, "response_format": { "type": "string", "enum": ["json", "verbose_json", "text"] }, "prompt": { "type": "string" }, "temperature": { "type": "number" } }, "required": ["file"] } } } },
        "responses": { "200": { "description": "transcription" } }
      }
    },
    "/v1/audio/translations": {
      "post": {
        "summary": "Translate audio to English (OpenAI-compatible)",
        "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" }, "model": { "type": "string" }, "response_format": { "type": "string", "enum": ["json", "verbose_json", "text"] }, "prompt": { "type": "string" } }, "required": ["file"] } } } },
        "responses": { "200": { "description": "translation" } }
      }
    },
    "/openapi.json": { "get": { "summary": "OpenAPI spec", "security": [], "responses": { "200": { "description": "spec" } } } },
    "/api/openapi.json": { "get": { "summary": "OpenAPI spec (alias)", "security": [], "responses": { "200": { "description": "spec" } } } }
  }
}
